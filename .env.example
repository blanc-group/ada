# --- Blanc MCP (company brain) ---
# URL del gateway. In dev: http://localhost:3000/mcp — in prod l'URL pubblico dietro Caddy.
BLANC_MCP_URL=http://localhost:3000/mcp
# API key dedicata ad ADA, con SOLI gli scope necessari (vedi README § Sicurezza).
# Genera con: pnpm apikey:create --name "ada-voice" --scopes "ghl:contacts:read,..."
BLANC_MCP_API_KEY=blanc_pk_...
# Tenant di default per le chiamate (opzionale): blanc-group | tarologia-evolutiva | bar-naut
BLANC_MCP_TENANT=

# --- Gemini (per la versione web e per il runner standalone) ---
GEMINI_API_KEY=

# --- Versione web ---
# Password condivisa che protegge la pagina web di ADA. Sceglila lunga.
ADA_WEB_PASSWORD=
# Porta del server web (default 8000).
#ADA_WEB_PORT=8000

# --- Personalizzazione ---
# Voce prebuilt Gemini. Default "Charon" (profonda e pacata, la piu vicina a Jarvis).
# Alternative da provare: Iapetus, Alnilam, Schedar, Enceladus.
ADA_VOICE=Charon
# Come ADA si rivolge a te.
ADA_USER_TITLE=Signore
# Modello Live (default: nativo audio 2.5 flash, lo stesso di ada_v2).
#ADA_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
# Lascia vuoto: i modelli native-audio rilevano la lingua automaticamente.
#ADA_LANGUAGE_CODE=
# Finestra (secondi) entro cui una scrittura confermata a voce puo essere rieseguita.
#ADA_CONFIRMATION_TTL=120
